{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hoshiro",
  "version": "0.1.5",
  "identifier": "cn.icybit.hoshiro",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hoshiro",
        "url": "index.html",
        "width": 1080,
        "height": 750,
        "minWidth": 880,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 22, "y": 26 },
        "visible": false,
        "create": false
      },
      {
        "label": "bar",
        "title": "Hoshiro Bar",
        "url": "index.html",
        "width": 560,
        "height": 460,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico", "icons/icon.png"],
    "resources": { "resources/sounds/*": "sounds/" },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/IcyBlue17/hoshiro/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNFMTJDQUNCMDA5NDY1MkQKUldRdFpaUUF5OG9TUGdIbURrR3ZhWGozcGFWOHJzS1RkRTFFc0xGVzZ0R0x0YWwzRmpvdG9nZzgK"
    }
  }
}
